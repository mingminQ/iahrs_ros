<?xml version="1.0"?>
<package format="3">

    <!-- Package imformation -->
    <name>iahrs_gui</name>
    <version>0.0.0</version>
    <description>IAHRS ROS2 GUI package</description>

    <!-- Maintainer and author -->
    <maintainer email="mgkilprg@gmail.com">Minkyu Kil</maintainer>
    <author>Minkyu Kil</author>

    <!-- License information -->
    <license>Apache-2.0</license>

    <!-- Build tool : ament_cmake -->
    <buildtool_depend>ament_cmake</buildtool_depend>

    <!-- Dependencies -->
    <depend>rclcpp     </depend>
    <depend>sensor_msgs</depend>
    <depend>iahrs_msgs </depend>
    <depend>iahrs_util </depend>
    <depend>tf2        </depend>
    <depend>Qt5Core    </depend>
    <depend>Qt5Widgets </depend>

    <!-- Export build system information -->
    <export>
        <build_type>ament_cmake</build_type>
    </export>

</package>